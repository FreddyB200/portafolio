---
import Shell from './Shell.astro';
import Hero from './Hero.astro';
import StatBar from './StatBar.astro';
import AboutPreview from './AboutPreview.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import Competitive from './Competitive.astro';
import ProjectsPreview from './ProjectsPreview.astro';
import Credentials from './Credentials.astro';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Shell lang={lang}>
  <Hero lang={lang} />
  <StatBar lang={lang} />
  <AboutPreview lang={lang} />
  <Experience lang={lang} />
  <Skills lang={lang} />
  <Competitive lang={lang} />
  <ProjectsPreview lang={lang} />
  <Credentials lang={lang} />
</Shell>

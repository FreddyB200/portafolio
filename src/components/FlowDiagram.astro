---
interface Props {
  label: string;
  steps: { title: string; detail: string }[];
  footnote?: string;
}
const { label, steps, footnote } = Astro.props;
---

<figure class="m-0">
  <figcaption class="meta mb-4 text-ink-soft">{label}</figcaption>
  <ol class="flex flex-col items-stretch gap-0 md:flex-row">
    {
      steps.map((s, i) => (
        <>
          {i > 0 && (
            <li aria-hidden="true" class="flow-arrow flex shrink-0 items-center justify-center py-1 font-mono text-ink-soft md:px-2 md:py-0">
              <span class="md:hidden">↓</span>
              <span class="hidden md:inline">→</span>
            </li>
          )}
          <li class="flex-1 border border-ink bg-surface p-4">
            <p class="meta text-ink">
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')} · </span>
              {s.title}
            </p>
            <p class="mt-2 text-[clamp(0.95rem,1vw,1.1rem)] leading-snug text-ink-soft">{s.detail}</p>
          </li>
        </>
      ))
    }
  </ol>
  {footnote && <p class="mt-4 text-[clamp(0.9rem,0.95vw,1.05rem)] leading-snug text-ink-soft">{footnote}</p>}
</figure>

---
import { copy, type Lang } from '../data/content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang].credentials;
---

<section id="credentials" aria-labelledby="credentials-title" class="border-t border-rule bg-surface">
  <div class="wrap py-16 md:py-24">
    <SectionHead id="credentials-title" label={c.label} title={c.title} />
    <div class="grid gap-14 md:grid-cols-2 md:gap-16">
      <div>
        <h3 class="meta border-b border-ink pb-3 text-ink">{c.educationHeading} & {c.languagesHeading}</h3>
        <ul>
          {
            c.education.map((e) => (
              <li class="border-b border-rule py-5">
                <p class="font-medium">{e.title}</p>
                <p class="meta mt-1 text-ink-soft">{e.place} · {e.dates}</p>
              </li>
            ))
          }
          <li class="py-5">
            <p class="meta mb-3 text-ink-soft">{c.languagesHeading}</p>
            <ul class="flex flex-wrap gap-2">
              {
                c.spoken.map((l) => (
                  <li class="tag">
                    {l.name} — {l.level}
                    {l.href && (
                      <>
                        {' '}
                        <a href={l.href} class="link" rel="noopener" aria-label={l.hrefLabel}>
                          ↗
                        </a>
                      </>
                    )}
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="meta border-b border-ink pb-3 text-ink">{c.credentialsHeading}</h3>
        <ul>
          {
            c.items.map((item) => (
              <li class="border-b border-rule py-5">
                <p class="font-semibold">{item.title}</p>
                <p class="mt-1 text-ink-soft">{item.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

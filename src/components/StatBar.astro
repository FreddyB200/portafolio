---
import { copy, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const stats = copy[lang].stats;
---

<section aria-label="At a glance" class="border-y border-rule bg-surface">
  <dl class="wrap grid grid-cols-2 md:grid-cols-4">
    {
      stats.map((s, i) => (
        <div
          class:list={[
            'py-6 pr-4 md:py-8',
            i % 2 === 1 && 'border-l border-rule pl-5',
            i > 1 && 'border-t border-rule md:border-t-0',
            i >= 1 && 'md:border-l md:border-rule md:pl-6',
          ]}
        >
          <dt class:list={['meta mb-2 text-ink-soft', i === 0 && 'is-current']}>{s.label}</dt>
          <dd class="font-display text-2xl font-extrabold leading-tight tracking-tight md:text-3xl">
            {s.value}
          </dd>
          {s.note && <dd class="mt-1 text-[clamp(0.95rem,1vw,1.1rem)] leading-snug text-ink-soft">{s.note}</dd>}
        </div>
      ))
    }
  </dl>
</section>

---
import { copy, type Lang } from '../data/content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang].skills;
---

<section id="skills" aria-labelledby="skills-title" class="border-y border-rule bg-surface">
  <div class="wrap py-16 md:py-24">
    <SectionHead id="skills-title" label={c.label} title={c.title} />
    <div class="border-t border-ink">
      {
        c.groups.map((g, i) => (
          <div class="reveal grid gap-4 border-b border-rule py-8 md:grid-cols-[var(--col1)_1fr] md:gap-8 md:py-10">
            <div>
              <h3 class="meta text-ink">
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')} · </span>
                {g.title}
                <span class="ml-1 font-normal text-ink-soft">({g.items.length})</span>
              </h3>
              <p class="mt-3 text-[clamp(0.95rem,1vw,1.1rem)] leading-snug text-ink-soft">{g.note}</p>
            </div>
            <ul class="flex flex-wrap content-start gap-2">
              {g.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

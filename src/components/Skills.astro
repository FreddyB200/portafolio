---
import { copy, type Lang } from '../data/content';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang].skills;

// "LLM integrations (OpenAI, Gemini)" -> name + small detail line
const split = (item: string) => {
  const m = item.match(/^(.*?)\s*\((.+)\)$/);
  return m ? { name: m[1], detail: m[2] } : { name: item, detail: '' };
};
---

<section id="skills" aria-labelledby="skills-title" class="border-y border-rule bg-surface">
  <div class="wrap py-16 md:py-24">
    <details open class="sect">
      <SectionHead lang={lang} id="skills-title" label={c.label} title={c.title} />
      <div class="border-t border-ink">
        {
          c.groups.map((g, i) => (
            <div class="reveal grid gap-5 border-b border-rule py-8 md:grid-cols-[var(--col1)_1fr] md:gap-8 md:py-10">
              <div>
                <h3 class="meta text-ink">
                  <span aria-hidden="true">{String(i + 1).padStart(2, '0')} · </span>
                  {g.title}
                  <span class="ml-1 font-normal text-ink-soft">({g.items.length})</span>
                </h3>
                <p class="mt-3 max-w-[22rem] text-[clamp(0.95rem,1vw,1.1rem)] leading-snug text-ink-soft">{g.note}</p>
              </div>
              <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,15.5rem),1fr))] gap-x-8 md:-mt-2.5">
                {g.items.map((item, n) => {
                  const { name, detail } = split(item);
                  return (
                    <li class="skill flex items-baseline gap-3 py-2.5">
                      <span class="meta w-6 shrink-0 text-ink-soft" aria-hidden="true">
                        {String(n + 1).padStart(2, '0')}
                      </span>
                      <span class="min-w-0">
                        <span class="block font-display text-[clamp(1.1rem,1.25vw,1.4rem)] font-semibold leading-snug tracking-tight">
                          {name}
                        </span>
                        {detail && <span class="mt-0.5 block text-[clamp(0.9rem,0.95vw,1.05rem)] leading-snug text-ink-soft">{detail}</span>}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </details>
  </div>
</section>

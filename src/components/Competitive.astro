---
import { copy, type Lang } from '../data/content';
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';

// Proof photos live in src/assets/evidence/ and are referenced by file name in content.ts.
const evidenceImages = import.meta.glob<{ default: ImageMetadata }>('../assets/evidence/*.{jpg,jpeg,png,webp}', { eager: true });
const imageFor = (file: string) => evidenceImages[`../assets/evidence/${file}`]?.default;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang].competitions;
---

<section id="competitions" aria-labelledby="competitions-title" class="wrap py-16 md:py-24">
<details open class="sect">
  <SectionHead lang={lang} id="competitions-title" label={c.label} title={c.title} />
  <ol class="focus-list border-t border-ink">
    {
      c.list.map((p) => (
        <li class="row reveal grid gap-6 border-b border-rule py-10 md:grid-cols-[var(--col1)_minmax(0,1fr)_minmax(0,1.7fr)] md:gap-8 md:py-12">
          <p class="font-display text-[clamp(2.5rem,5vw,3.5rem)] font-extrabold leading-none tracking-tighter">
            {p.place}
          </p>

          <div>
            <h3 class="font-display text-[clamp(1.5rem,1.9vw,2.2rem)] font-bold leading-tight tracking-tight">{p.name}</h3>
            <p class="mt-1 text-[clamp(1.05rem,1.15vw,1.3rem)] font-medium leading-snug">{p.subtitle}</p>
            <p class="meta mt-4 text-ink-soft">{c.hostLabel}</p>
            <p class="text-[clamp(1.05rem,1.1vw,1.25rem)] font-medium leading-snug">{p.event}</p>
            {p.context && <p class="mt-1.5 text-[clamp(0.95rem,1vw,1.1rem)] leading-snug text-ink-soft">{p.context}</p>}
            <p class="meta mt-4 text-ink-soft">{c.roleLabel}</p>
            <p class="text-[clamp(1.05rem,1.1vw,1.25rem)] font-medium leading-snug">{p.role}</p>
          </div>

          <div>
            <dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-y border-ink py-5 sm:grid-cols-3">
              {p.stats.map((s) => (
                <div>
                  <dd class="stat-num">{s.value}</dd>
                  <dt class="meta mt-2 text-ink-soft">{s.label}</dt>
                </div>
              ))}
            </dl>
            <p class="prose-lg mt-6 max-w-[48rem] text-ink-soft">{p.description}</p>
            {p.links.length > 0 && (
              <ul class="meta mt-5 flex flex-wrap gap-x-6 gap-y-2">
                {p.links.map((l) => (
                  <li>
                    <a href={l.href} class="link" rel="noopener">
                      {l.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {((p.evidence?.length ?? 0) > 0 || (p.images?.length ?? 0) > 0) && (
              <details class="sect mt-7 border-t border-rule">
                <summary class="meta flex items-center justify-between gap-4 py-4 text-ink">
                  <span>
                    {c.evidenceLabel} ({(p.evidence?.length ?? 0) + (p.images?.length ?? 0)})
                  </span>
                  <span class="sect-toggle !mt-0" aria-hidden="true">
                    <i />
                  </span>
                </summary>
                <div class="grid gap-6 pb-2 pt-2 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
                  {(p.images?.length ?? 0) > 0 && (
                    <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,14rem),1fr))] gap-3">
                      {p.images!.map((img) => {
                        const src = imageFor(img.file);
                        return (
                          src && (
                            <li class="border border-rule">
                              <Image src={src} alt={img.alt} widths={[480, 800]} sizes="(min-width: 768px) 28vw, 90vw" format="webp" loading="lazy" class="h-full w-full object-cover" />
                            </li>
                          )
                        );
                      })}
                    </ul>
                  )}
                  {(p.evidence?.length ?? 0) > 0 && (
                    <ul class="meta flex flex-col gap-3">
                      {p.evidence!.map((l) => (
                        <li>
                          <a href={l.href} class="link" rel="noopener">
                            {l.label} ↗
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</details>
</section>

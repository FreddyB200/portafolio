---
import { copy, careerStart, monthsSince, formatDuration, durationUnits, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang].experience;
const ui = copy[lang].ui;
const duration = formatDuration(monthsSince(careerStart), lang);
---

<section id="experience" aria-labelledby="experience-title" class="wrap py-16 md:py-24">
<details open class="sect">
  <summary class="sect-sum reveal mb-10 flex flex-col gap-3 md:mb-14 md:grid md:grid-cols-[var(--col1)_1fr] md:gap-8">
    <p class="meta sec-label pt-2 text-ink-soft">{c.label}</p>
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 id="experience-title" class="text-[clamp(2.25rem,5.2vw,4.75rem)]">{c.title}</h2>
      <p class="md:text-right">
        <span class="block font-display text-[clamp(1.25rem,1.8vw,1.75rem)] font-extrabold leading-none tracking-tight">{c.range}</span>
        <span class="meta mt-2 block text-ink-soft">
          <span
            data-exp-start={careerStart}
            data-exp-units={JSON.stringify(durationUnits[lang])}
            class="font-semibold text-ink">{duration}</span
          >
          {c.durationSuffix}
        </span>
      </p>
      <span class="sect-toggle meta" aria-hidden="true">
        <span class="when-open">{ui.hide}</span><span class="when-closed">{ui.show}</span>
        <i></i>
      </span>
    </div>
  </summary>

  <ol class="focus-list border-t border-ink">
    {
      c.jobs.map((job, i) => (
        <li class="row reveal grid gap-3 border-b border-rule py-8 md:grid-cols-[var(--col1)_minmax(0,1fr)_minmax(0,1.7fr)] md:gap-8 md:py-10">
          <p class:list={['meta text-ink-soft', i === 0 && 'is-current']}>{job.dates}</p>
          <div>
            <h3 class="font-display text-[clamp(1.5rem,1.9vw,2.2rem)] font-bold leading-tight tracking-tight">{job.company}</h3>
            <p class="mt-2 text-[clamp(1.05rem,1.15vw,1.3rem)] font-medium leading-snug">{job.role}</p>
            <p class="meta mt-2 text-ink-soft">{job.place}</p>
          </div>
          <div>
            <div class="prose-lg max-w-[48rem] space-y-5 text-ink-soft">
              {job.story.map((p) => <p>{p}</p>)}
            </div>
            <ul class="mt-7 flex flex-wrap gap-2" aria-label={c.technologies}>
              {job.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</details>
</section>

<script>
  // Keep the "time worked" exact even if the site is not redeployed this month.
  const el = document.querySelector<HTMLElement>('[data-exp-start]');
  if (el) {
    try {
      const u = JSON.parse(el.dataset.expUnits ?? '{}');
      const [sy, sm] = (el.dataset.expStart ?? '').split('-').map(Number);
      const now = new Date();
      const total = Math.max(0, (now.getFullYear() - sy) * 12 + (now.getMonth() + 1 - sm));
      const y = Math.floor(total / 12);
      const m = total % 12;
      const parts: string[] = [];
      if (y > 0) parts.push(`${y} ${u.y[y === 1 ? 0 : 1]}`);
      if (m > 0 || y === 0) parts.push(`${m} ${u.m[m === 1 ? 0 : 1]}`);
      el.textContent = parts.join(u.sep);
    } catch (e) {}
  }
</script>

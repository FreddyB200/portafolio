---
import { copy, links, site, pathFor, hrefFor, langs, type Lang, type PageKey } from '../data/content';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  page?: PageKey;
  slug?: string;
}
const { lang, page = 'home', slug } = Astro.props;
const c = copy[lang];
// A nav item is "current" only when it points at the page itself, not at a section of home.
const isCurrent = (item: (typeof c.nav)[number]) => item.page === page && !item.hash;
---

<header class="sticky top-0 z-40 border-b border-rule bg-bg/95 backdrop-blur">
  <div class="wrap flex items-center justify-between gap-3 py-3 xl:gap-6">
    <a href={pathFor(lang)} class="font-display text-base font-bold tracking-tight text-ink no-underline xs:text-lg">
      {site.name.split(' ').slice(0, 2).join(' ')}
    </a>

    <nav aria-label={c.ui.navLabel} class="flex items-center gap-3 xl:gap-5">
      <ul class="hidden items-center gap-5 xl:flex">
        {
          c.nav.map((item) => (
            <li>
              <a
                href={hrefFor(lang, item.page, item.hash)}
                aria-current={isCurrent(item) ? 'page' : undefined}
                class="meta text-ink-soft no-underline hover:text-accent-ink hover:underline aria-[current=page]:text-ink aria-[current=page]:underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a href={links.resume} class="meta hidden text-ink underline decoration-1 hover:text-accent-ink xs:inline">
        <span class="hidden sm:inline">{c.ui.resume}</span>
        <span class="sm:hidden">{c.ui.resumeShort}</span>
      </a>

      <div role="group" aria-label={c.ui.langLabel} class="inline-flex">
        {
          langs.map((l, i) => (
            <a
              href={pathFor(l, page, slug)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              class:list={['ctl w-9 sm:w-10', i > 0 && '-ml-[1.5px]']}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>

      <ThemeToggle toDark={c.ui.themeToDark} toLight={c.ui.themeToLight} />

      <!-- Below xl the links do not fit in the bar: they open as a full-width panel. -->
      <details class="navmenu group xl:hidden">
        <summary class="ctl w-9 list-none [&::-webkit-details-marker]:hidden" aria-label={c.ui.menu} title={c.ui.menu}>
          <svg class="group-open:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="hidden group-open:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <div class="absolute inset-x-0 top-full border-b border-ink bg-bg">
          <ul class="wrap py-2">
            {
              c.nav.map((item) => (
                <li class="border-b border-rule last:border-b-0">
                  <a
                    href={hrefFor(lang, item.page, item.hash)}
                    aria-current={isCurrent(item) ? 'page' : undefined}
                    class="meta block py-4 text-ink no-underline hover:text-accent-ink aria-[current=page]:underline"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="border-t border-rule">
              <a href={links.resume} class="meta block py-4 text-ink no-underline hover:text-accent-ink">{c.ui.resume}</a>
            </li>
          </ul>
        </div>
      </details>
    </nav>
  </div>
  <div aria-hidden="true" class="scroll-progress absolute inset-x-0 -bottom-px h-[3px] origin-left scale-x-0 bg-accent-ink"></div>
</header>

<script>
  // Close the mobile menu after choosing a link (same-page anchors do not reload the page) or on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('details.navmenu');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

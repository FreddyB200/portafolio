---
import { Image } from 'astro:assets';
import { copy, links, type Lang } from '../data/content';
import photo from '../assets/freddy.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];
---

<section id="top" class="lg:grid lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
  <!-- Text side: left edge aligns with the page grid, right edge stops at the photo -->
  <div
    class="px-[var(--gutter)] pb-14 pt-12 md:pb-20 md:pt-20 lg:py-[clamp(4rem,7vw,8rem)] lg:pr-[clamp(2rem,3.4vw,5rem)]"
  >
    <p class="meta mb-8 text-ink-soft md:mb-12">{c.hero.eyebrow}</p>
    <h1 class="text-[clamp(2.25rem,4vw,5.5rem)] text-ink">
      {c.hero.headline.map((line) => <span class="block [text-wrap:balance]">{line}</span>)}
    </h1>

    <div
      class="mt-10 grid max-w-[64rem] gap-6 font-display text-[clamp(1.0625rem,1.3vw,1.3rem)] font-medium leading-[1.5] tracking-[-0.005em] text-ink-soft md:mt-14 md:grid-cols-2 md:gap-10"
    >
      {c.hero.paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a href={`mailto:${links.email}`} class="btn btn-solid">{links.email}</a>
      <a href={links.github} class="btn" rel="noopener">GitHub</a>
      <a href={links.linkedin} class="btn" rel="noopener">LinkedIn</a>
      <a href={links.resume} class="btn">{c.ui.resume}</a>
    </div>
  </div>

  <!-- Photo side: full bleed, edge to edge, original colour -->
  <figure class="relative aspect-[4/3] border-t border-ink sm:aspect-[16/10] lg:aspect-auto lg:min-h-full lg:border-l lg:border-t-0">
    <Image
      src={photo}
      alt={c.hero.photoAlt}
      widths={[640, 960, 1200]}
      sizes="(min-width: 1024px) 40vw, 100vw"
      format="webp"
      quality={82}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-[62%_center]"
    />
  </figure>
</section>

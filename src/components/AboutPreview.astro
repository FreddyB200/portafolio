---
import { copy, pathFor, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang].aboutPreview;
---

<section id="about" aria-labelledby="about-title" class="wrap py-14 md:py-20">
  <div class="reveal grid gap-4 md:grid-cols-[var(--col1)_1fr] md:gap-8">
    <p class="meta sec-label pt-2 text-ink-soft">{c.label}</p>
    <div>
      <h2 id="about-title" class="sr-only">{copy[lang].about.title}</h2>
      <p class="prose-lg max-w-[48rem]">{c.text}</p>
      <a href={pathFor(lang, 'about')} class="btn btn-accent mt-6">{c.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

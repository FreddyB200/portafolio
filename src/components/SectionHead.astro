---
import { copy, type Lang } from '../data/content';

interface Props {
  id: string;
  label: string;
  title: string;
  lang: Lang;
}
const { id, label, title, lang } = Astro.props;
const ui = copy[lang].ui;
---

<summary class="sect-sum reveal mb-10 flex flex-col gap-3 md:mb-14 md:grid md:grid-cols-[var(--col1)_1fr] md:gap-8">
  <p class="meta sec-label pt-2 text-ink-soft">{label}</p>
  <div class="flex items-start justify-between gap-6">
    <h2 id={id} class="text-[clamp(2.25rem,5.2vw,4.75rem)] [text-wrap:balance]">{title}</h2>
    <span class="sect-toggle meta" aria-hidden="true">
      <span class="when-open">{ui.hide}</span><span class="when-closed">{ui.show}</span>
      <i></i>
    </span>
  </div>
</summary>

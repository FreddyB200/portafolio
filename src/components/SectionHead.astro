---
interface Props {
  id: string;
  label: string;
  title: string;
}
const { id, label, title } = Astro.props;
---

<div class="reveal mb-10 flex flex-col gap-3 md:mb-14 md:grid md:grid-cols-[var(--col1)_1fr] md:gap-8">
  <p class="meta sec-label pt-2 text-ink-soft">{label}</p>
  <h2 id={id} class="text-[clamp(2.25rem,5.2vw,4.75rem)] [text-wrap:balance]">{title}</h2>
</div>

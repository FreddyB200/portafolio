---
import Shell from '../components/Shell.astro';
import PageHead from '../components/PageHead.astro';
import Story from '../components/Story.astro';
import Credentials from '../components/Credentials.astro';
import { copy, pathFor, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];
const a = c.about;
const jobs = c.experience.jobs;
const edu = c.credentials.education;
const podiums = c.competitions.list;

// The three acts reuse content that already lives in Experience and Credentials.
// Jobs are listed newest first in content.ts, so index 2 is the first job.
const acts = [
  { jobs: [jobs[2]], edu: [edu[0]], podiums: false },
  { jobs: [jobs[1]], edu: [edu[1]], podiums: true },
  { jobs: [jobs[0]], edu: [], podiums: false },
];
---

<Shell lang={lang} page="about" title={a.metaTitle} description={a.metaDescription}>
  <PageHead lang={lang} crumbs={[{ label: a.title }]} label={a.label} title={a.title} lead={a.intro[0]} />

  <div class="wrap">
  {
    a.acts.map((act, i) => (
      <Story label={act.label} title={act.title}>
        <p class="prose-lg max-w-[48rem] text-ink-soft">{act.blurb}</p>

        {acts[i].jobs.map((job) => (
          <article class="mt-8 border-t border-rule pt-6">
            <p class:list={['meta text-ink-soft', i === 2 && 'is-current']}>{job.dates}</p>
            <h3 class="mt-2 font-display text-[clamp(1.5rem,1.9vw,2.2rem)] font-bold leading-tight tracking-tight">{job.company}</h3>
            <p class="mt-1 text-[clamp(1.05rem,1.15vw,1.3rem)] font-medium leading-snug">{job.role}</p>
            <div class="prose-lg mt-4 max-w-[48rem] space-y-5 text-ink-soft">
              {job.story.map((p) => <p>{p}</p>)}
            </div>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label={c.experience.technologies}>
              {job.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </article>
        ))}

        {acts[i].edu.map((e) => (
          <p class="mt-6 border-t border-rule pt-6">
            <span class="block text-[clamp(1.15rem,1.3vw,1.45rem)] font-semibold leading-snug">{e.title}</span>
            <span class="meta mt-1 block text-ink-soft">{e.place} · {e.dates}</span>
          </p>
        ))}

        {acts[i].podiums && (
          <div class="mt-6 border-t border-rule pt-6">
            <h3 class="meta text-ink">{a.hackathonsHeading}</h3>
            <ul class="mt-3">
              {podiums.map((p) => (
                <li class="border-b border-rule py-4">
                  <a href={pathFor(lang, 'hackathons', p.slug)} class="link text-[clamp(1.15rem,1.3vw,1.45rem)] font-semibold leading-snug">
                    {p.place} · {p.name}
                  </a>
                  <span class="meta mt-1 block text-ink-soft">{p.event}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </Story>
    ))
  }
  </div>

  <Credentials lang={lang} />
</Shell>

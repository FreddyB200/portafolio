---
import '../styles/global.css';
// Latin subset only (covers English and Spanish). The other alphabets are never needed.
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import serif from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import plex400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plex500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import { site, copy, langs, pathFor, links, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];

const fontFaces = `
@font-face{font-family:"Bricolage Grotesque Variable";font-style:normal;font-display:swap;font-weight:200 800;src:url(${bricolage}) format("woff2-variations"),url(${bricolage}) format("woff2")}
@font-face{font-family:"Source Serif 4 Variable";font-style:normal;font-display:swap;font-weight:200 900;src:url(${serif}) format("woff2-variations"),url(${serif}) format("woff2")}
@font-face{font-family:"IBM Plex Mono";font-style:normal;font-display:swap;font-weight:400;src:url(${plex400}) format("woff2")}
@font-face{font-family:"IBM Plex Mono";font-style:normal;font-display:swap;font-weight:500;src:url(${plex500}) format("woff2")}
`;

const canonical = new URL(pathFor(lang), site.url).href;
const ogImage = new URL('/og.png', site.url).href;
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#F7F6F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1113" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), site.url).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en'), site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts needed for the first paint: fetch them in parallel with the HTML -->
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex500} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={c.ogLocale} />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.meta.title} />
    <meta name="twitter:description" content={c.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Apply the saved (or system) theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.name,
        url: site.url,
        jobTitle: 'Backend & Infrastructure Engineer',
        address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
        sameAs: [links.github, links.linkedin],
      })}
    />
  </head>
  <body>
    <a
      href="#main"
      class="meta fixed left-3 top-3 z-50 -translate-y-20 bg-ink px-3 py-2 text-bg focus:translate-y-0"
    >
      {c.ui.skip}
    </a>
    <slot />
  </body>
</html>
